<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".presentation.ui.create_product_movement.CreateProductMovementFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:text="Categoría"
            android:textColor="@color/text_animation"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="25dp"
            android:background="@drawable/custom_input"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_selector_right_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/purple_700"
            android:focusable="true"
            android:gravity="center_vertical"
            android:hint="Selecciona una categoría"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="1dp"
            android:text="Producto"
            android:textColor="@color/text_animation"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProduct"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="25dp"
            android:background="@drawable/custom_input"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_selector_right_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/design_default_color_secondary_variant"
            android:focusable="true"
            android:gravity="center_vertical"
            android:hint="Selecciona un Producto"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:textSize="18sp" />



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="1dp"
            android:text="Almacen Inicial"
            android:textColor="@color/text_animation"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvInitialWarehouse"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="25dp"
            android:background="@drawable/custom_input"
            android:drawableStart="@drawable/custom_amount_icon"
            android:drawablePadding="12dp"
            android:hint="Almacen "
            android:gravity="center_vertical"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="1dp"
            android:text="Zona Inicial"
            android:textColor="@color/text_animation"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvInitialAreaWarehouse"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="25dp"
            android:background="@drawable/custom_input"
            android:drawableStart="@drawable/custom_amount_icon"
            android:drawablePadding="12dp"
            android:hint="Zona"
            android:gravity="center_vertical"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Cantidad del Producto"
                    android:textColor="@color/text_animation"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvInitialQuantity"
                    android:layout_width="150dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="25dp"
                    android:background="@drawable/custom_input"
                    android:drawableStart="@drawable/custom_amount_icon"
                    android:drawablePadding="12dp"
                    android:hint="Cantidad"
                    android:gravity="center_vertical"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="18sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Cantidad a mover"
                    android:textColor="@color/text_animation"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etFinalQuantity"
                    android:layout_width="150dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="25dp"
                    android:background="@drawable/custom_input"
                    android:drawableStart="@drawable/custom_amount_icon"
                    android:drawablePadding="12dp"
                    android:hint="Cantidad"
                    android:gravity="center_vertical"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/dotted_line"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="0dp"
            android:text="Almacenes Destino"
            android:textColor="@color/text_animation"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFinalWarehouse"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="25dp"
            android:background="@drawable/custom_input"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_selector_right_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/teal_200"
            android:focusable="true"
            android:gravity="center_vertical"
            android:hint="Selecciona un Almacen"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Zonas Destino"
            android:textColor="@color/text_animation"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFinalAreaWarehouse"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="25dp"
            android:background="@drawable/custom_input"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_selector_right_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/purple_700"
            android:focusable="true"
            android:gravity="center_vertical"
            android:hint="Selecciona una zona"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Razón del Movimiento"
            android:textColor="@color/text_animation"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTypeMovement"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="25dp"
            android:background="@drawable/custom_input"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_selector_right_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/purple_700"
            android:focusable="true"
            android:gravity="center_vertical"
            android:hint="Selecciona una Razón"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCreatNewMovement"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:layout_height="55dp"
            android:paddingHorizontal="50dp"
            android:text="Crear Movimiento"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:layout_marginTop="20dp"
            android:backgroundTint="#FF4500  "
            style="@style/StyleButtonPrimary"
            />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>